@echo off
setlocal EnableExtensions
title Used Laptop Inspector v2.3
color 0B

if /I not "%~1"=="RUN" (
    start "Used Laptop Inspector - Diagnostic" cmd /k call "%~f0" RUN
    exit /b
)

set "BASE=%~dp0"
set "OUT=%BASE%Laptop_Report.html"
set "LOG=%BASE%Laptop_Inspector_Log.txt"
set "INSPECT_OUT=%OUT%"
set "INSPECTTMP=%TEMP%\LaptopInspector_%RANDOM%_%RANDOM%"
set "PS1=%INSPECTTMP%\inspect.ps1"
mkdir "%INSPECTTMP%" >nul 2>&1

echo ============================================================
echo              USED LAPTOP INSPECTOR v2.5
echo ============================================================
echo.
echo Detailed inspection mode
echo.
> "%LOG%" echo ===== Used Laptop Inspector v2.5 =====
>>"%LOG%" echo Started: %DATE% %TIME%
>>"%LOG%" echo Computer: %COMPUTERNAME%
>>"%LOG%" echo.
echo [1/3] Preparing inspection engine...
echo.
> "%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo 
>>"%INSPECTTMP%\worker.b64" echo W0lPLkZpbGVdOjpXcml0ZUFsbFRleHQoJG91dCwkaHRtbCxbVGV4dC5VVEY4RW5jb2RpbmddOjpuZXcoJGZhbHNlKSkKV3JpdGUtT3V0cHV0ICdIVE1MX0NSRUFURUQnCg==

echo [2/3] Building inspection engine...
echo.
certutil -f -decode "%INSPECTTMP%\worker.b64" "%PS1%" >nul 2>&1
if errorlevel 1 goto FAIL
if not exist "%PS1%" goto FAIL
echo Running detailed hardware inspection...
echo Please wait...
echo.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%PS1%" >>"%LOG%" 2>&1
if errorlevel 1 goto FAIL
echo.
echo [3/3] Checking report...
if not exist "%OUT%" goto FAIL
echo.
echo ============================================================
echo                    SCAN COMPLETE
echo ============================================================
echo.
echo Report: "%OUT%"
echo.
start "" "%OUT%"
goto CLEAN

:FAIL
echo.
echo ============================================================
echo                    ERROR FOUND
echo ============================================================
echo.
echo The diagnostic window will remain open.
echo.
echo ---------------- LOG ----------------
type "%LOG%"
echo -------------- END LOG --------------
echo.
echo Report was not created successfully.
echo.
pause
goto CLEAN

:CLEAN
del /q "%PS1%" >nul 2>&1
rd /s /q "%INSPECTTMP%" >nul 2>&1
exit /b
